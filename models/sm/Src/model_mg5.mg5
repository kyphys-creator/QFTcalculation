# Step (1) of the SM note: tree diagrams generated by MadGraph 3.8.1 from the UFO of SM.fr
# (restriction restrict_massless.dat: all fermions massless except the top).
# Run from Src/ after generate_SM.wl and make_restrict.py (run_model_check.sh copies the UFO to work/).
# Expected numbers of diagrams (hand counts, note Table diagrams): unitary gauge / Feynman gauge
#   e+ e- > mu+ mu-   2 / 2      e+ e- > e+ e-     4 / 4      e+ e- > ve ve~   2 / 2     e+ e- > vm vm~  1 / 1
#   e+ e- > u u~      2 / 2      e+ e- > t t~      2 / 2      e+ e- > w+ w-    3 / 3     e+ e- > z h     1 / 1
#   e+ e- > z z       2 / 2      u u~ > w+ w-      3 / 3      a a > w+ w-      3 / 5     w+ w- > w+ w-   7 / 7
#   w+ w- > z z       4 / 6      w+ w- > h h       4 / 6      z z > h h        4 / 6     g g > t t~      3 / 3
#   g g > t t~ h      8 / 8      t > b w+          1 / 1      h > w+ w-        1 / 1     u d~ > w+ h     1 / 1
#   e- ve~ > mu- vm~  1 / 1
set automatic_html_opening False
set gauge unitary
import model ./work/SM_UFO-massless
generate e+ e- > mu+ mu-
generate e+ e- > e+ e-
generate e+ e- > ve ve~
generate e+ e- > vm vm~
generate e+ e- > u u~
generate e+ e- > t t~
generate e+ e- > w+ w-
generate e+ e- > z h
generate e+ e- > z z
generate u u~ > w+ w-
generate a a > w+ w-
generate w+ w- > w+ w-
generate w+ w- > z z
generate w+ w- > h h
generate z z > h h
generate g g > t t~
generate g g > t t~ h
generate t > b w+
generate h > w+ w-
generate u d~ > w+ h
generate e- ve~ > mu- vm~
set gauge Feynman
import model ./work/SM_UFO-massless
generate e+ e- > mu+ mu-
generate e+ e- > e+ e-
generate e+ e- > ve ve~
generate e+ e- > vm vm~
generate e+ e- > u u~
generate e+ e- > t t~
generate e+ e- > w+ w-
generate e+ e- > z h
generate e+ e- > z z
generate u u~ > w+ w-
generate a a > w+ w-
generate w+ w- > w+ w-
generate w+ w- > z z
generate w+ w- > h h
generate z z > h h
generate g g > t t~
generate g g > t t~ h
generate t > b w+
generate h > w+ w-
generate u d~ > w+ h
generate e- ve~ > mu- vm~
