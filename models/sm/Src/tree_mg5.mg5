# tree_mg5.mg5 -- tree-level widths and cross sections with the SM UFO (research note models/sm, step (2)).
# Run from Src/ via run_tree_check.sh (imports copies of generated/SM_UFO in work/; MadGraph converts UFOs in place).
# Parameters: the UFO's default card (alpha(MZ)^-1 = 127.9, G_F, M_Z -> M_W = 79.82; Gamma_Z = 2.4952 in propagators).
# 1. compute_widths z w+ h t (two-body, FeynRules formulas, unrestricted model: all masses, Cabibbo angle 0.227736)
#    -> work/widths_card.dat;  the muon width mu- > vm e- ve~ (phase-space integration, m_e and m_mu of the card).
# 2. restricted model SM_UFO-massless (cabi = 0; e, mu, u, d, s, c massless): e+ e- > mu+ mu- at sqrt(s) = 30, 91.1876,
#    200 and e+ e- > w+ w- at 200, 500, 1000, fixed-energy beams, all generation cuts off.  tree_numeric.py relies on this order.
#    Fixed seeds (iseed 101-107), so a rerun reproduces the numbers of the note.
set automatic_html_opening False
import model ./work/SM_UFO
compute_widths z w+ h t --body_decay=2 --output=./work/widths_card.dat
generate mu- > vm e- ve~
output work/mg5_mudecay -f
launch work/mg5_mudecay
0
set nevents 100000
set use_syst False
set iseed 101
0
import model ./work/SM_UFO-massless
generate e+ e- > mu+ mu-
output work/mg5_eemumu -f
launch work/mg5_eemumu
0
set lpp1 0
set lpp2 0
set nevents 100000
set use_syst False
set ptl 0
set etal -1
set drll 0
set ebeam1 15.0
set ebeam2 15.0
set iseed 102
0
launch work/mg5_eemumu
0
set ebeam1 45.5938
set ebeam2 45.5938
set iseed 103
0
launch work/mg5_eemumu
0
set ebeam1 100.0
set ebeam2 100.0
set iseed 104
0
generate e+ e- > w+ w-
output work/mg5_eeww -f
launch work/mg5_eeww
0
set lpp1 0
set lpp2 0
set nevents 100000
set use_syst False
set ebeam1 100.0
set ebeam2 100.0
set iseed 105
0
launch work/mg5_eeww
0
set ebeam1 250.0
set ebeam2 250.0
set iseed 106
0
launch work/mg5_eeww
0
set ebeam1 500.0
set ebeam2 500.0
set iseed 107
0
quit
