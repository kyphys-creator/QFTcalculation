# Step (1) of the abelian Higgs note: tree diagrams generated by MadGraph 3.8.1 from the UFO of AbelianHiggs.fr.
# Run from Src/ after generate_AbelianHiggs.wl (run_model_check.sh copies the UFO to work/, because MadGraph converts
# UFOs to Python 3 in place).
# Expected numbers of diagrams (hand counts, note Table diagrams): unitary gauge / Feynman gauge
#   h > zp zp          1 / 1      zp zp > zp zp      3 / 3      zp zp > h h        4 / 6
#   h h > h h          4 / 4      zp h > zp h        4 / 6      zp zp > zp zp h   21 / 33
set automatic_html_opening False
set gauge unitary
import model ./work/AbelianHiggs_UFO
generate h > zp zp
generate zp zp > zp zp
generate zp zp > h h
generate h h > h h
generate zp h > zp h
generate zp zp > zp zp h
set gauge Feynman
import model ./work/AbelianHiggs_UFO
generate h > zp zp
generate zp zp > zp zp
generate zp zp > h h
generate h h > h h
generate zp h > zp h
generate zp zp > zp zp h
quit
