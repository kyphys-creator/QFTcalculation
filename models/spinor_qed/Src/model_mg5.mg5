# model_mg5.mg5 -- diagrams of the 2 -> 2 and 2 -> 3 processes from the SpinorQED UFO
# (research note models/spinor_qed, step (1)).  Run via run_model_check.sh (imports a copy in work/,
# because MadGraph converts UFOs to Python 3 in place).
# Expected: 1, 2, 2, 2, 1, 2 diagrams for the 2 -> 2 processes (A) e+ e- > mu+ mu-, (B) Bhabha, (C) Compton,
# (D) e+ e- > a a, e- mu- > e- mu-, Moller, and 4, 8, 6 for e+ e- > mu+ mu- a, e+ e- > e+ e- a, e+ e- > a a a.
set automatic_html_opening False
import model ./work/SpinorQED_UFO
generate e+ e- > mu+ mu-
display diagrams_text
generate e+ e- > e+ e-
display diagrams_text
generate e- a > e- a
display diagrams_text
generate e+ e- > a a
display diagrams_text
generate e- mu- > e- mu-
display diagrams_text
generate e- e- > e- e-
display diagrams_text
generate e+ e- > mu+ mu- a
display diagrams_text
generate e+ e- > e+ e- a
display diagrams_text
generate e+ e- > a a a
display diagrams_text
quit
