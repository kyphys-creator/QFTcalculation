# Step (1) of the CKM note: tree diagrams generated by MadGraph 3.8.1 from the UFO of SM_CKM.fr
# (restriction restrict_massless.dat: all fermions massless except the top; the CKM parameters keep their benchmark
# values, so every V_ij is nonzero).  Run from Src/ after generate_SM_CKM.wl and make_restrict.py
# (run_model_check.sh copies the UFO to work/).
# Expected numbers of diagrams (hand counts, note Table diagrams): unitary gauge / Feynman gauge
#  The 21 processes of the SM note (same counts there, except u u~ > w+ w-, 3 / 3 with V = 1):
#   e+ e- > mu+ mu-   2 / 2      e+ e- > e+ e-     4 / 4      e+ e- > ve ve~   2 / 2     e+ e- > vm vm~  1 / 1
#   e+ e- > u u~      2 / 2      e+ e- > t t~      2 / 2      e+ e- > w+ w-    3 / 3     e+ e- > z h     1 / 1
#   e+ e- > z z       2 / 2      u u~ > w+ w-      5 / 5      a a > w+ w-      3 / 5     w+ w- > w+ w-   7 / 7
#   w+ w- > z z       4 / 6      w+ w- > h h       4 / 6      z z > h h        4 / 6     g g > t t~      3 / 3
#   g g > t t~ h      8 / 8      t > b w+          1 / 1      h > w+ w-        1 / 1     u d~ > w+ h     1 / 1
#   e- ve~ > mu- vm~  1 / 1
#  Processes that need V_ij off the diagonal (no diagrams with V = 1, or more diagrams than with V = 1):
#   u s~ > w+ h       1 / 1      t > s w+          1 / 1      t > d w+         1 / 1     t~ > b~ w-      1 / 1
#   u s~ > e+ ve      1 / 1      u b~ > e+ ve      1 / 1      c d~ > e+ ve     1 / 1     d d~ > w+ w-    5 / 5
#   t t~ > w+ w-      6 / 6      u d~ > c s~       1 / 1      u s~ > c d~      1 / 1     u u~ > d s~     1 / 1
#   u c~ > d s~       1 / 1      t s~ > w+ h       2 / 3
set automatic_html_opening False
set gauge unitary
import model ./work/SM_CKM_UFO-massless
generate e+ e- > mu+ mu-
generate e+ e- > e+ e-
generate e+ e- > ve ve~
generate e+ e- > vm vm~
generate e+ e- > u u~
generate e+ e- > t t~
generate e+ e- > w+ w-
generate e+ e- > z h
generate e+ e- > z z
generate u u~ > w+ w-
generate a a > w+ w-
generate w+ w- > w+ w-
generate w+ w- > z z
generate w+ w- > h h
generate z z > h h
generate g g > t t~
generate g g > t t~ h
generate t > b w+
generate h > w+ w-
generate u d~ > w+ h
generate e- ve~ > mu- vm~
generate u s~ > w+ h
generate t > s w+
generate t > d w+
generate t~ > b~ w-
generate u s~ > e+ ve
generate u b~ > e+ ve
generate c d~ > e+ ve
generate d d~ > w+ w-
generate t t~ > w+ w-
generate u d~ > c s~
generate u s~ > c d~
generate u u~ > d s~
generate u c~ > d s~
generate t s~ > w+ h
set gauge Feynman
import model ./work/SM_CKM_UFO-massless
generate e+ e- > mu+ mu-
generate e+ e- > e+ e-
generate e+ e- > ve ve~
generate e+ e- > vm vm~
generate e+ e- > u u~
generate e+ e- > t t~
generate e+ e- > w+ w-
generate e+ e- > z h
generate e+ e- > z z
generate u u~ > w+ w-
generate a a > w+ w-
generate w+ w- > w+ w-
generate w+ w- > z z
generate w+ w- > h h
generate z z > h h
generate g g > t t~
generate g g > t t~ h
generate t > b w+
generate h > w+ w-
generate u d~ > w+ h
generate e- ve~ > mu- vm~
generate u s~ > w+ h
generate t > s w+
generate t > d w+
generate t~ > b~ w-
generate u s~ > e+ ve
generate u b~ > e+ ve
generate c d~ > e+ ve
generate d d~ > w+ w-
generate t t~ > w+ w-
generate u d~ > c s~
generate u s~ > c d~
generate u u~ > d s~
generate u c~ > d s~
generate t s~ > w+ h
