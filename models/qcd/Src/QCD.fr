(* ::Package:: *)

(* QCD.fr -- FeynRules model file for QCD with five massless quarks and one heavy quark, plus a photon and a
   massless electron as an external probe (models/qcd/ResearchNote/note.tex, Eq. (1)).

   L = -1/4 G^a_{mu nu} G^{a mu nu} - cbar^a d^mu D_mu^{ab} c^b + sum_q qbar (i Dslash - m_q) q
       - 1/4 F_{mu nu} F^{mu nu} + ebar i Dslash e,
   D_mu = d_mu - i gs T^a G^a_mu - i ee Q A_mu   (FeynRules' sign convention for DC)
   (gs is called G in the UFO, alpha_s = gs^2/(4 pi) is the external parameter aS, the heavy-quark mass is MT)

   - G: the gluon (SU(3) adjoint, index Gluon);  ghG: its Faddeev-Popov ghost;  A: the photon.
   - Quarks (colour triplets): uq = {u, c} (Q = 2/3), dq = {d, s, b} (Q = -1/3), all massless (n_l = 5), and the heavy
     quark tq = t (Q = 2/3, mass MT).  elec: the massless electron (Q = -1), colour singlet.
   - The photon and the electron only serve as the external current for e+ e- -> hadrons; QED is never corrected.
   - Feynman rules: gluon propagator -i delta^{ab} [g - (1 - xi) k k/k^2]/k^2 (FeynArts: GaugeXi[G]; MadGraph uses
     Feynman gauge), ghost propagator i delta^{ab}/k^2, quark-gluon vertex i gs T^a gamma^mu, photon vertex
     i ee Q gamma^mu; the three- and four-gluon and the ghost vertices follow from FS[G] and the ghost term.
   - The gauge-fixing term -(d.G)^2/(2 xi) and the counterterms are not written here; they are added when the loop
     calculation is set up (FeynCalc), as in the note.  The ghost term -ghGbar.del[DC[ghG]] is the one of SM.fr.
   - Coupling orders (MadGraph): gs counts QCD = 1, ee counts QED = 1.  The names aS (block SMINPUTS, 3) and G are the
     ones MadGraph expects for the strong coupling.
   - Standard PDG codes (1-6, 11, 21, 22, ghost 82) and particle names (d, u, s, c, b, t, e-, g, a), so MadGraph
     process strings read as usual.
   - Load from this folder:
       $FeynRulesPath = FileNameJoin[{$UserBaseDirectory, "Applications", "FeynRules"}];
       SetDirectory[$FeynRulesPath]; << FeynRules`
       SetDirectory[".../models/qcd/Src"]; LoadModel["QCD.fr"]
*)

M$ModelName = "QCD";

M$Information = {
  Authors -> {"K. Yasuda"},
  Date    -> "2026-10-14",
  Version -> "1.0",
  Comment -> "QCD with five massless quarks and one heavy quark, plus a photon/electron probe (cross-check model for the loop stack)"
};

M$InteractionOrderHierarchy = {
  {QCD, 1},
  {QED, 2}
};

(* ************************** *)
(* *****  Gauge groups  ***** *)
(* ************************** *)

M$GaugeGroups = {
  U1EM == {
    Abelian          -> True,
    CouplingConstant -> ee,
    GaugeBoson       -> A,
    Charge           -> Q
  },
  SU3C == {
    Abelian           -> False,
    CouplingConstant  -> gs,
    GaugeBoson        -> G,
    StructureConstant -> f,
    Representations   -> {T, Colour},
    SymmetricTensor   -> dSUN
  }
};

(* ************************** *)
(* *****    Indices     ***** *)
(* ************************** *)

IndexRange[Index[Gluon  ]] = NoUnfold[Range[8]];
IndexRange[Index[Colour ]] = NoUnfold[Range[3]];
IndexRange[Index[UpGen  ]] = Range[2];
IndexRange[Index[DownGen]] = Range[3];

IndexStyle[Gluon,   a];
IndexStyle[Colour,  m];
IndexStyle[UpGen,   f];
IndexStyle[DownGen, g];

(* ************************** *)
(* *****   Parameters   ***** *)
(* ************************** *)

M$Parameters = {
  aS == {
    ParameterType    -> External,
    BlockName        -> SMINPUTS,
    OrderBlock       -> 3,
    Value            -> 0.0795774715459477,
    InteractionOrder -> {QCD, 2},
    TeX              -> Subscript[\[Alpha], s],
    Description      -> "Strong coupling constant alpha_s = gs^2/(4 pi) (benchmark gs = 1)"
  },
  gs == {
    ParameterType    -> Internal,
    Value            -> Sqrt[4 Pi aS],
    InteractionOrder -> {QCD, 1},
    TeX              -> Subscript[g, s],
    ParameterName    -> G,
    Description      -> "Strong coupling constant"
  },
  ee == {
    ParameterType    -> External,
    BlockName        -> QEDBLOCK,
    OrderBlock       -> 1,
    Value            -> 1.0,
    InteractionOrder -> {QED, 1},
    TeX              -> e,
    Description      -> "Electric charge unit of the photon probe"
  }
};

(* ************************** *)
(* *****   Particles    ***** *)
(* ************************** *)

M$ClassesDescription = {
  V[1] == {
    ClassName       -> A,
    SelfConjugate   -> True,
    Mass            -> 0,
    Width           -> 0,
    ParticleName    -> "a",
    PDG             -> 22,
    PropagatorLabel -> "a",
    PropagatorType  -> Sine,
    PropagatorArrow -> None,
    FullName        -> "Photon"
  },
  V[2] == {
    ClassName       -> G,
    SelfConjugate   -> True,
    Indices         -> {Index[Gluon]},
    Mass            -> 0,
    Width           -> 0,
    ParticleName    -> "g",
    PDG             -> 21,
    PropagatorLabel -> "G",
    PropagatorType  -> C,
    PropagatorArrow -> None,
    FullName        -> "Gluon"
  },
  U[2] == {
    ClassName       -> ghG,
    SelfConjugate   -> False,
    Indices         -> {Index[Gluon]},
    Ghost           -> G,
    PDG             -> 82,
    QuantumNumbers  -> {GhostNumber -> 1},
    Mass            -> 0,
    Width           -> 0,
    PropagatorLabel -> "uG",
    PropagatorType  -> GhostDash,
    PropagatorArrow -> Forward
  },
  F[1] == {
    ClassName        -> elec,
    SelfConjugate    -> False,
    Mass             -> 0,
    Width            -> 0,
    QuantumNumbers   -> {Q -> -1},
    PDG              -> 11,
    PropagatorLabel  -> "e",
    PropagatorType   -> Straight,
    PropagatorArrow  -> Forward,
    ParticleName     -> "e-",
    AntiParticleName -> "e+",
    FullName         -> "Electron"
  },
  F[2] == {
    ClassName        -> uq,
    ClassMembers     -> {u, c},
    Indices          -> {Index[UpGen], Index[Colour]},
    FlavorIndex      -> UpGen,
    SelfConjugate    -> False,
    Mass             -> 0,
    Width            -> 0,
    QuantumNumbers   -> {Q -> 2/3},
    PropagatorLabel  -> {"uq", "u", "c"},
    PropagatorType   -> Straight,
    PropagatorArrow  -> Forward,
    PDG              -> {2, 4},
    ParticleName     -> {"u", "c"},
    AntiParticleName -> {"u~", "c~"},
    FullName         -> {"u-quark", "c-quark"}
  },
  F[3] == {
    ClassName        -> dq,
    ClassMembers     -> {d, s, b},
    Indices          -> {Index[DownGen], Index[Colour]},
    FlavorIndex      -> DownGen,
    SelfConjugate    -> False,
    Mass             -> 0,
    Width            -> 0,
    QuantumNumbers   -> {Q -> -1/3},
    PropagatorLabel  -> {"dq", "d", "s", "b"},
    PropagatorType   -> Straight,
    PropagatorArrow  -> Forward,
    PDG              -> {1, 3, 5},
    ParticleName     -> {"d", "s", "b"},
    AntiParticleName -> {"d~", "s~", "b~"},
    FullName         -> {"d-quark", "s-quark", "b-quark"}
  },
  F[4] == {
    ClassName        -> tq,
    Indices          -> {Index[Colour]},
    SelfConjugate    -> False,
    Mass             -> {MT, 1.0},
    Width            -> {WT, 0},
    QuantumNumbers   -> {Q -> 2/3},
    PDG              -> 6,
    PropagatorLabel  -> "t",
    PropagatorType   -> Straight,
    PropagatorArrow  -> Forward,
    ParticleName     -> "t",
    AntiParticleName -> "t~",
    FullName         -> "Heavy quark"
  }
};

GaugeXi[V[1]] = GaugeXi[A];
GaugeXi[V[2]] = GaugeXi[G];
GaugeXi[U[2]] = GaugeXi[G];

(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

(* FS[G, mu, nu, aa] = d_mu G_nu - d_nu G_mu + gs f^{abc} G^b_mu G^c_nu and DC is the covariant derivative
   d - I gs T^a G^a - I ee Q A.  The ghost term is -cbar d^mu D_mu c with the adjoint covariant derivative.
   The parentheses keep the multi-line expressions one statement (see PsYukawa.fr). *)
LGaugeQCD := Block[{mu, nu, aa},
  ExpandIndices[(-1/4 FS[G, mu, nu, aa] FS[G, mu, nu, aa] - 1/4 FS[A, mu, nu] FS[A, mu, nu])]];

LFermionQCD := Block[{mu},
  ExpandIndices[(I elecbar.Ga[mu].DC[elec, mu]
    + I uqbar.Ga[mu].DC[uq, mu] + I dqbar.Ga[mu].DC[dq, mu]
    + I tqbar.Ga[mu].DC[tq, mu] - MT tqbar.tq)]];

LGhostQCD := Block[{mu, ii},
  ExpandIndices[-ghGbar[ii].del[DC[ghG[ii], mu], mu]]];

LQCD := LGaugeQCD + LFermionQCD + LGhostQCD;
