Cell["\<\
The model file contains two particle classes :

- The class F[1], a fermion represented by a symbol q, containing three \
members (u, c, t).
- The class V[1], a vector represented by the symbol G.

Furthermore, the model contains a gauge group SU3C, connected to the gauge \
boson G. Notice that the field strength tensor connected with G is defined \
automatically by FeynRules:\
\>", "Text",
 CellChangeTimes->{{3.405056036651124*^9, 
  3.4050562183720837`*^9}},ExpressionUUID->"a8f99213-37d4-4ea6-ac08-\
18f7fa116947"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FS", "[", 
  RowBox[{"G", ",", "\[Mu]", ",", "\[Nu]", ",", "a"}], "]"}]], "Input",
 CellChangeTimes->{{3.405056219218893*^9, 3.405056236551928*^9}, {
  3.955898599957718*^9, 3.955898608610938*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"01be922a-22a3-442a-9612-b55352027800"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FormBox[
     SubscriptBox["g", "s"],
     TraditionalForm], " ", 
    FormBox[
     SubscriptBox["G", 
      RowBox[{"\[Mu]", ",", "bb$23240"}]],
     TraditionalForm], " ", 
    FormBox[
     SubscriptBox["G", 
      RowBox[{"\[Nu]", ",", "cc$23240"}]],
     TraditionalForm], " ", 
    FormBox[
     SubscriptBox["f", 
      RowBox[{"a", ",", "bb$23240", ",", "cc$23240"}]],
     TraditionalForm]}], "-", 
   FormBox[
    RowBox[{
     SubscriptBox["\<\"\[PartialD]\"\>", "\[Nu]"], "(", 
     FormBox[
      SubscriptBox["G", 
       RowBox[{"\[Mu]", ",", "a"}]],
      TraditionalForm], ")"}],
    TraditionalForm], "+", 
   FormBox[
    RowBox[{
     SubscriptBox["\<\"\[PartialD]\"\>", "\[Mu]"], "(", 
     FormBox[
      SubscriptBox["G", 
       RowBox[{"\[Nu]", ",", "a"}]],
      TraditionalForm], ")"}],
    TraditionalForm]}], TraditionalForm]], "Output",
 CellChangeTimes->{3.9558971440259*^9, 3.955898555532085*^9, 
  3.9558986036371937`*^9, 3.955898671969932*^9},
 CellLabel->"Out[13]=",ExpressionUUID->"80ace60b-de8a-4486-a07b-d620228d9932"]
}, Open  ]],

Cell["\<\
The $ varaibles are nothing special, they are just defined internally by \
Mathematica in order not to interfere with existing, user - defined \
variables. \
\>", "Text",
 CellChangeTimes->{{3.405056243781961*^9, 
  3.405056286169486*^9}},ExpressionUUID->"e2c7f647-73d9-4f84-8f6b-\
31b682ddb390"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The lagrangian", "Section",
 CellChangeTimes->{{3.405056363448367*^9, 
  3.40505636561475*^9}},ExpressionUUID->"7acd6a16-25e1-4ab1-bd3e-\
293edb429e23"],

Cell["The lagrangian is entered in the usual textbook way", "Text",
 CellChangeTimes->{{3.4050562932761497`*^9, 3.405056293480383*^9}, {
  3.405056384742694*^9, 3.405056391703071*^9}, {3.405056448676361*^9, 
  3.405056453888558*^9}},ExpressionUUID->"74479057-562c-471f-bb72-\
4d7ac0cdddad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"L", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", "1"}], "/", "4"}], 
    RowBox[{"FS", "[", 
     RowBox[{"G", ",", "\[Mu]", ",", "\[Nu]", ",", "a"}], "]"}], 
    RowBox[{"FS", "[", 
     RowBox[{"G", ",", "\[Mu]", ",", "\[Nu]", ",", "a"}], "]"}]}], "+", 
   RowBox[{"I", " ", 
    RowBox[{"qbar", ".", 
     RowBox[{"Ga", "[", "\[Mu]", "]"}], ".", 
     RowBox[{"DC", "[", 
      RowBox[{"q", ",", "\[Mu]"}], "]"}]}]}], "-", 
   RowBox[{
    RowBox[{"MQ", "[", "ff", "]"}], " ", 
    RowBox[{
     RowBox[{"qbar", "[", 
      RowBox[{"s", ",", "ff", ",", "i"}], "]"}], ".", 
     RowBox[{"q", "[", 
      RowBox[{"s", ",", "ff", ",", "i"}], "]"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.4050564602005167`*^9, 3.405056646301014*^9}, {
  3.405056909869131*^9, 3.405056916498315*^9}, {3.423416634663773*^9, 
  3.42341665572878*^9}, {3.423416720554686*^9, 3.423416722086699*^9}, {
  3.453996904704235*^9, 3.453996912367002*^9}, {3.556421383059156*^9, 
  3.556421389539173*^9}, {3.556421557985771*^9, 3.556421560473724*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"28fe994b-8264-4e9b-a2cc-29d58abd8329"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"-", 
    RowBox[{
     RowBox[{"MQ", "(", "ff", ")"}], " ", 
     RowBox[{
      FormBox[
       SubscriptBox[
        OverscriptBox["q", "\<\"-\"\>"], 
        RowBox[{"s", ",", "ff", ",", "i"}]],
       TraditionalForm], ".", 
      FormBox[
       SubscriptBox["q", 
        RowBox[{"s", ",", "ff", ",", "i"}]],
       TraditionalForm]}]}]}], "+", 
   RowBox[{"\[ImaginaryI]", " ", 
    RowBox[{
     FormBox[
      OverscriptBox["q", "\<\"-\"\>"],
      TraditionalForm], ".", 
     FormBox[
      TemplateBox[{"\[Gamma]", "\[Mu]"},
       "Superscript"],
      TraditionalForm], ".", 
     RowBox[{"(", 
      RowBox[{
       FormBox[
        RowBox[{
         SubscriptBox["\<\"\[PartialD]\"\>", "\[Mu]"], "(", "q", ")"}],
        TraditionalForm], "-", 
       RowBox[{"\[ImaginaryI]", " ", 
        FormBox[
         SubscriptBox["g", "s"],
         TraditionalForm], " ", 
        RowBox[{
         FormBox[
          SuperscriptBox["T", "PRIVATE`a$23719"],
          TraditionalForm], ".", "q"}], " ", 
        FormBox[
         SubscriptBox["G", 
          RowBox[{"\[Mu]", ",", "PRIVATE`a$23719"}]],
         TraditionalForm]}]}], ")"}]}]}], "-", 
   RowBox[{
    FractionBox["1", "4"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FormBox[
        SubscriptBox["g", "s"],
        TraditionalForm], " ", 
       FormBox[
        SubscriptBox["G", 
         RowBox[{"\[Mu]", ",", "bb$23717"}]],
        TraditionalForm], " ", 
       FormBox[
        SubscriptBox["G", 
         RowBox[{"\[Nu]", ",", "cc$23717"}]],
        TraditionalForm], " ", 
       FormBox[
        SubscriptBox["f", 
         RowBox[{"a", ",", "bb$23717", ",", "cc$23717"}]],
        TraditionalForm]}], "-", 
      FormBox[
       RowBox[{
        SubscriptBox["\<\"\[PartialD]\"\>", "\[Nu]"], "(", 
        FormBox[
         SubscriptBox["G", 
          RowBox[{"\[Mu]", ",", "a"}]],
         TraditionalForm], ")"}],
       TraditionalForm], "+", 
      FormBox[
       RowBox[{
        SubscriptBox["\<\"\[PartialD]\"\>", "\[Mu]"], "(", 
        FormBox[
         SubscriptBox["G", 
          RowBox[{"\[Nu]", ",", "a"}]],
         TraditionalForm], ")"}],
       TraditionalForm]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FormBox[
        SubscriptBox["g", "s"],
        TraditionalForm], " ", 
       FormBox[
        SubscriptBox["G", 
         RowBox[{"\[Mu]", ",", "bb$23718"}]],
        TraditionalForm], " ", 
       FormBox[
        SubscriptBox["G", 
         RowBox[{"\[Nu]", ",", "cc$23718"}]],
        TraditionalForm], " ", 
       FormBox[
        SubscriptBox["f", 
         RowBox[{"a", ",", "bb$23718", ",", "cc$23718"}]],
        TraditionalForm]}], "-", 
      FormBox[
       RowBox[{
        SubscriptBox["\<\"\[PartialD]\"\>", "\[Nu]"], "(", 
        FormBox[
         SubscriptBox["G", 
          RowBox[{"\[Mu]", ",", "a"}]],
         TraditionalForm], ")"}],
       TraditionalForm], "+", 
      FormBox[
       RowBox[{
        SubscriptBox["\<\"\[PartialD]\"\>", "\[Mu]"], "(", 
        FormBox[
         SubscriptBox["G", 
          RowBox[{"\[Nu]", ",", "a"}]],
         TraditionalForm], ")"}],
       TraditionalForm]}], ")"}]}]}], TraditionalForm]], "Output",
 CellChangeTimes->{3.955897147217894*^9, 3.955898677194591*^9},
 CellLabel->"Out[14]=",ExpressionUUID->"50beeb47-8608-40ad-962c-3130efd3aeee"]
}, Open  ]],

Cell["\<\
Two comments about this expression :

1) Notice the appearance of the term FS[G, \[Mu], \[Nu], a] FS[G, \[Mu], \
\[Nu], a] instead of FS[G, \[Mu], \[Nu], a]^2. This is crucial because FS \
contains internal connected indices (See the \"$-varaibles\" in the expresion \
for L.

2) The anti quarks can be entered by using the predefined symbol qbar\
\>", "Text",
 CellChangeTimes->{{3.405056665564649*^9, 3.405056825676083*^9}, {
  3.556421353921274*^9, 
  3.556421364809576*^9}},ExpressionUUID->"01bd0468-815d-48e8-bd50-\
b7c4d597a39f"],

Cell[CellGroupData[{

Cell[BoxData["qbar"], "Input",
 CellChangeTimes->{{3.405056828832439*^9, 3.405056839241992*^9}, {
  3.556421367149097*^9, 3.556421368777916*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"9a4cac01-1a98-467b-b8b2-2334a827ff8f"],

Cell[BoxData[
 FormBox[
  OverscriptBox["q", "\<\"-\"\>"], TraditionalForm]], "Output",
 CellChangeTimes->{3.9558987102326403`*^9},
 CellLabel->"Out[15]=",ExpressionUUID->"9c33a93a-3c6d-45d8-b9d0-94d772613afb"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["The ToolBox functions", "Section",
 CellChangeTimes->{{3.412621711134922*^9, 
  3.412621715160161*^9}},ExpressionUUID->"05e603b8-291b-45e9-90ec-\
eaf72ae25f45"],

Cell["\<\
There are several functions in FeynRules which can be of interes during the \
model building phase independently form the Feynman rule calculation. These \
functions are stored in the ToolBox. The FeynRules ToolBox is meant to be the \
place where the user can store his own functions, and reuse them at any time.

For a detailed description of the default content of the ToolBox, just have a \
look at the corresponding page on the FeynRules TWiki.
The most important functions included in the current distribution of the \
ToolBox are\
\>", "Text",
 CellChangeTimes->{{3.412621720242196*^9, 3.412621840150249*^9}, {
  3.4126218764085073`*^9, 3.412621912838396*^9}, {3.412623019804165*^9, 
  3.41262302463389*^9}},ExpressionUUID->"4a1c2760-c4a2-474e-a06f-\
e17b4dcb96f3"],

