Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     FormBox["\<\"e\"\>",
      TraditionalForm], "2"], " ", "phi", " ", 
    SuperscriptBox[
     FormBox[
      SubscriptBox["A", 
       FormBox["mu",
        TraditionalForm]],
      TraditionalForm], "2"], " ", 
    FormBox[
     SuperscriptBox["phi", "\[Dagger]"],
     TraditionalForm]}], "+", 
   RowBox[{"\[ImaginaryI]", " ", 
    FormBox["\<\"e\"\>",
     TraditionalForm], " ", 
    FormBox[
     SubscriptBox["A", 
      FormBox["mu",
       TraditionalForm]],
     TraditionalForm], " ", 
    FormBox[
     SuperscriptBox["phi", "\[Dagger]"],
     TraditionalForm], " ", 
    FormBox[
     RowBox[{
      SubscriptBox["\<\"\[PartialD]\"\>", 
       FormBox["mu",
        TraditionalForm]], "(", "phi", ")"}],
     TraditionalForm]}], "-", 
   RowBox[{"\[ImaginaryI]", " ", 
    FormBox["\<\"e\"\>",
     TraditionalForm], " ", "phi", " ", 
    FormBox[
     SubscriptBox["A", 
      FormBox["mu",
       TraditionalForm]],
     TraditionalForm], " ", 
    FormBox[
     RowBox[{
      SubscriptBox["\<\"\[PartialD]\"\>", 
