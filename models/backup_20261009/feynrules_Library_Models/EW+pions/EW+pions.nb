Cell["FeynArts also supports the Feynman gauge", "Text",
 CellChangeTimes->{{3.4121854851672792`*^9, 
  3.412185494183435*^9}},ExpressionUUID->"ad48b693-bb37-41b7-a93a-\
5bee041fc1f0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"FeynmanGauge", " ", "=", " ", "True"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"WriteFeynArtsOutput", "[", 
  RowBox[{
  "LGauge", ",", "LHiggs", ",", "LFermions", ",", "LYukawa", ",", "LGhost", ",",
    " ", "LCS", ",", 
   RowBox[{"FlavorExpand", "\[Rule]", "SU2W"}], ",", 
   RowBox[{"Output", "\[Rule]", "\"\<EW+pions\>\""}], ",", 
   RowBox[{"CouplingRename", "->", "Automatic"}]}], "    ", 
  RowBox[{"(*", 
   RowBox[{
   "\:8907\:6570\:30ed\:30fc\:30ec\:30f3\:30c4\:69cb\:9020\:3092", " ", "1", " ",
