Cell[CellGroupData[{

Cell["Pion Effective Interaction sector", "Subsubsection",
 CellChangeTimes->{{3.4119102216473637`*^9, 3.411910224608881*^9}, {
  3.411910393742139*^9, 3.411910394852953*^9}, {3.4119106057673063`*^9, 
  3.411910606397141*^9}, {3.956762526351142*^9, 3.9567625303492517`*^9}, {
  3.956795148067136*^9, 
  3.956795155667553*^9}},ExpressionUUID->"76556f0e-1fa9-46e3-9855-\
34b42eaeadfa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"LEff", ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     FractionBox["aEW", 
      RowBox[{"8", "Pi", " ", "fpi"}]]}], " ", 
    RowBox[{"Eps", "[", 
     RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]"}], "]"}], 
    " ", "pi0", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"del", "[", 
       RowBox[{
        RowBox[{"A", "[", "\[Mu]", "]"}], ",", "\[Nu]"}], "]"}], "-", 
      RowBox[{"del", "[", 
       RowBox[{
        RowBox[{"A", "[", "\[Nu]", "]"}], ",", "\[Mu]"}], "]"}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"del", "[", 
       RowBox[{
        RowBox[{"A", "[", "\[Alpha]", "]"}], ",", "\[Beta]"}], "]"}], "-", 
      RowBox[{"del", "[", 
       RowBox[{
        RowBox[{"A", "[", "\[Beta]", "]"}], ",", "\[Alpha]"}], "]"}]}], 
     ")"}]}], "-", 
   RowBox[{
    FractionBox[
     SuperscriptBox["mpi", "2"], "2"], "pi0", " ", "pi0"}], " ", "+", " ", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"del", "[", 
     RowBox[{"pi0", ",", "\[Mu]"}], "]"}], 
    RowBox[{"del", "[", 
     RowBox[{"pi0", ",", "\[Mu]"}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"CheckHermiticity", "[", "LCS", "]"}]}], "Input",
 CellChangeTimes->{{3.956766012578079*^9, 3.9567660415372677`*^9}, {
  3.9567664171345577`*^9, 3.956766461518882*^9}, {3.9567665247298527`*^9, 
  3.956766589043247*^9}, {3.9567666246824503`*^9, 3.95676668987469*^9}, {
  3.9567950542640343`*^9, 3.9567951264280033`*^9}, {3.956795162299284*^9, 
  3.9567951630001383`*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"578e9eed-b4cb-43dd-a789-5edfe9a03710"],

