Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", 
    FractionBox["1", "4"]}], " ", 
   SuperscriptBox[
    RowBox[{
     SubscriptBox["\<\"\[PartialD]\"\>", "nu"], "[", 
     SubscriptBox["A", "mu"], "]"}], "2"]}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{
    SubscriptBox["\<\"\[PartialD]\"\>", "nu"], "[", 
    SubscriptBox["A", "mu"], "]"}], " ", 
   RowBox[{
    SubscriptBox["\<\"\[PartialD]\"\>", "mu"], "[", 
    SubscriptBox["A", "nu"], "]"}]}], "-", 
  RowBox[{
   FractionBox["1", "4"], " ", 
   SuperscriptBox[
    RowBox[{
     SubscriptBox["\<\"\[PartialD]\"\>", "mu"], "[", 
     SubscriptBox["A", "nu"], "]"}], "2"]}], "+", 
  RowBox[{"\[ImaginaryI]", " ", 
   RowBox[{
    SubscriptBox["\<\"\[PartialD]\"\>", "mu"], "[", 
    SubscriptBox["psi", "s2"], "]"}], " ", 
   RowBox[{"gamma", "[", 
    RowBox[{"mu", ",", "s1", ",", "s2"}], "]"}], " ", 
   SubscriptBox[
    OverscriptBox["psi", "\<\"-\"\>"], "s1"]}], "-", 
  RowBox[{"\<\"m_f\"\>", " ", 
   SubscriptBox["psi", "s1"], " ", 
   SubscriptBox[
    OverscriptBox["psi", "\<\"-\"\>"], "s1"]}], "+", 
  RowBox[{"\<\"e\"\>", " ", 
   SubscriptBox["A", "mu"], " ", 
   RowBox[{"gamma", "[", 
    RowBox[{"mu", ",", "s1", ",", "s2"}], "]"}], " ", 
   SubscriptBox["psi", "s2"], " ", 
   SubscriptBox[
    OverscriptBox["psi", "\<\"-\"\>"], "s1"], " ", 
   RowBox[{"Qem", "[", 
    SubscriptBox["psi", "s2"], "]"}]}]}]], "Output",
 CellChangeTimes->{3.955901904364086*^9, 3.9561946369374313`*^9, 
  3.956195303700942*^9, 3.956195816194298*^9, 3.956245249791421*^9, 
