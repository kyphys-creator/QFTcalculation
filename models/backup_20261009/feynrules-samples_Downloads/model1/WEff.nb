Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{
    SubscriptBox["g", "L"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       OverscriptBox["uq", "\<\"-\"\>"], ".", "CLq", ".", 
       TemplateBox[{"\[Gamma]", "mu"},
        "Superscript"], ".", 
       SubscriptBox["P", "\<\"-\"\>"], ".", "dq"}], "+", 
      RowBox[{
       OverscriptBox["vl", "\<\"-\"\>"], ".", "CLl", ".", 
       TemplateBox[{"\[Gamma]", "mu"},
        "Superscript"], ".", 
       SubscriptBox["P", "\<\"-\"\>"], ".", "l"}]}], ")"}], " ", 
    SubscriptBox["Wp", "mu"]}], 
   SqrtBox["2"]], "+", 
  FractionBox[
   RowBox[{
    SubscriptBox["g", "R"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       OverscriptBox["uq", "\<\"-\"\>"], ".", "CRq", ".", 
       TemplateBox[{"\[Gamma]", "mu"},
        "Superscript"], ".", 
       SubscriptBox["P", "\<\"+\"\>"], ".", "dq"}], "+", 
      RowBox[{
       OverscriptBox["vl", "\<\"-\"\>"], ".", "CRl", ".", 
       TemplateBox[{"\[Gamma]", "mu"},
        "Superscript"], ".", 
       SubscriptBox["P", "\<\"+\"\>"], ".", "l"}]}], ")"}], " ", 
    SubscriptBox["Wp", "mu"]}], 
   SqrtBox["2"]], "+", 
  FractionBox[
   RowBox[{
    SubscriptBox["g", "L"], " ", 
    RowBox[{
     OverscriptBox["dq", "\<\"-\"\>"], ".", 
     SuperscriptBox["CLq", "\[Dagger]"], ".", 
     TemplateBox[{"\[Gamma]", "mu"},
      "Superscript"], ".", 
     SubscriptBox["P", "\<\"-\"\>"], ".", "uq"}], " ", 
    SubsuperscriptBox["Wp", "mu", "\[Dagger]"]}], 
   SqrtBox["2"]], "+", 
  FractionBox[
   RowBox[{
    SubscriptBox["g", "R"], " ", 
    RowBox[{
     OverscriptBox["dq", "\<\"-\"\>"], ".", 
     SuperscriptBox["CRq", "\[Dagger]"], ".", 
     TemplateBox[{"\[Gamma]", "mu"},
      "Superscript"], ".", 
     SubscriptBox["P", "\<\"+\"\>"], ".", "uq"}], " ", 
    SubsuperscriptBox["Wp", "mu", "\[Dagger]"]}], 
   SqrtBox["2"]], "+", 
  FractionBox[
   RowBox[{
    SubscriptBox["g", "L"], " ", 
    RowBox[{
     OverscriptBox["l", "\<\"-\"\>"], ".", 
     SuperscriptBox["CLl", "\[Dagger]"], ".", 
     TemplateBox[{"\[Gamma]", "mu"},
      "Superscript"], ".", 
     SubscriptBox["P", "\<\"-\"\>"], ".", "vl"}], " ", 
    SubsuperscriptBox["Wp", "mu", "\[Dagger]"]}], 
   SqrtBox["2"]], "+", 
  FractionBox[
   RowBox[{
    SubscriptBox["g", "R"], " ", 
    RowBox[{
     OverscriptBox["l", "\<\"-\"\>"], ".", 
     SuperscriptBox["CRl", "\[Dagger]"], ".", 
     TemplateBox[{"\[Gamma]", "mu"},
      "Superscript"], ".", 
