          SubscriptBox["\<\"f\"\>", "1"], ",", 
          SubscriptBox["\<\"f\"\>", "2"]}]], " ", 
        SubscriptBox["\[Delta]", 
         RowBox[{
          SubscriptBox["\<\"m\"\>", "1"], ",", 
          SubscriptBox["\<\"m\"\>", "2"]}]], " ", 
        SubscriptBox[
         RowBox[{
          TemplateBox[{"\[Gamma]", 
