(* ::Package:: *)

(* Copied unchanged (apart from this line and the folder below) from models/sm_ckm/Src/SM_CKM.fr, the model of the NLO note
   models/sm_nlo.
   SM_CKM.fr -- FeynRules model file of the Standard Model with the CKM matrix, in the MS-bar scheme and a general
   R_xi gauge (models/sm_ckm/ResearchNote/note.tex, Eqs. (L), (Y), (QL)).  Made from models/sm/Src/SM.fr (the SM
   note's model, V_CKM = 1); the only changes are the CKM parameters, the down-type quark in the left-handed doublet
   and the Yukawa term (marked "CKM:" below).  The FeynRules SM.fr was read for the syntax of the unitarity rules only.

   L = -1/4 B_{mu nu}^2 - 1/4 W^a_{mu nu}^2 - 1/4 G^a_{mu nu}^2 + sum_psi psibar i Dslash psi
       + (D Phi)^dagger (D Phi) + muH2 Phi^dagger Phi - lam (Phi^dagger Phi)^2
       - (QLbar Yd Phi dR + LLbar Yl Phi lR + QLbar Yu Phitilde uR + h.c.) + L_gf + L_FP,
   in the basis where the doublet is QL = (uL, V dL) with the mass eigenstates uq, dq:  Yu = yu (diagonal),
   Yd = V.yd (yd diagonal), Yl = yl (diagonal).  V = CKM is unitary; with PDG's standard parametrization
   (s12, s23, s13, dCKM) it carries the four CKM parameters of the Standard Model.
   D_mu = d_mu - i gs T^a G^a_mu - i gw T^a W^a_mu - i g1 Y B_mu    (FeynRules' sign convention, Peskin-Schroeder)
   Q = T^3 + Y,  Y(QL, LL, uR, dR, lR, Phi) = 1/6, -1/2, 2/3, -1/3, -1, 1/2,
   Phi = (-i G+, (vev + H + i G0)/sqrt 2)  (Peskin-Schroeder's phase of the charged Goldstone),
   W+ = (W1 - i W2)/sqrt 2,  Z = cw W3 - sw B,  A = sw W3 + cw B,  ee = gw sw = g1 cw,
   so that every field couples to the photon through D_mu = d_mu - i ee Q A_mu as in the QED and QCD notes.

   - Parameters.  All parameters are MS-bar running parameters at one scale mu (the values below are a benchmark,
     not fitted).  The independent set of the note is (gw, g1, gs, lam, muH2, y_f); the file uses the equivalent set
     (aEWM1 = 4 pi/ee^2, MW, MZ, MH, fermion masses, aS) of MS-bar quantities defined by the tree relations
     MW = gw vev/2, MZ = sqrt(gw^2 + g1^2) vev/2, MH^2 = 2 lam vev^2 = 2 muH2, m_f = y_f vev/sqrt 2.
     vev = sqrt(muH2/lam) is the minimum of the tree potential (the tadpoles are not cancelled, note Sec. 2).
   - CKM: external s12, s23, s13 (sines of the angles) and dCKM (the phase) in block CKMBLOCK; the benchmark values
     are the PDG 2024 global fit (not fitted here).  Internal complex matrix CKM[i, j] (row: up-type generation,
     column: down-type generation), Unitary -> True.  The neutral currents and the neutral Yukawa terms contain
     V^dagger V and are made flavour diagonal by the replacement rules ckmUnitarity (V^dagger V = V V^dagger = 1).
   - Massless left-handed neutrinos (no PMNS matrix).
   - Gauge fixing (note Eq. (gf)), written in renormalized fields and not added here because it has no vertices:
       L_gf = -(d.A)^2/(2 xiA) - (d.Z - xiZ MZ G0)^2/(2 xiZ) - (d.W+ - xiW MW G+)(d.W- - xiW MW G-)/xiW.
     L_FP = - sum_k ubar^k s F^k with the BRST variations s V = D u (adjoint) and s Phi = i (gw u^a T^a + g1 Y u^B) Phi.
     The ghost-scalar part  xiZ MZ ubarZ s G0 + xiW MW (ubar+ s G+ + ubar- s G-)  is computed below from s Phi
     (LGhostScalar); ubar+ (ghWpbar) is the antighost paired with u+ (ghWp).
   - Gauge parameters: xiA, xiZ, xiW, xiG (block GAUGE, value 1 = Feynman gauge for MadGraph).  In the FeynArts model
     the propagators carry GaugeXi[A], GaugeXi[Z], GaugeXi[W], GaugeXi[G]; generate_SM_CKM.wl writes the FeynArts
     model with xiZ -> GaugeXi[Z], xiW -> GaugeXi[W] in the ghost-scalar couplings.
   - Coupling orders (MadGraph): ee and the Yukawa couplings count QED = 1, gs counts QCD = 1.
   - Load from this folder:
       $FeynRulesPath = FileNameJoin[{$UserBaseDirectory, "Applications", "FeynRules"}];
       SetDirectory[$FeynRulesPath]; << FeynRules`
       SetDirectory[".../models/sm_nlo/Src"]; LoadModel["SM_CKM.fr"]
*)

(* The Lagrangian always contains the Goldstone bosons and the ghosts (general R_xi gauge).  FeynmanGauge = True
   only makes the UFO declare gauge = [0, 1], so that MadGraph accepts "set gauge Feynman"; MadGraph removes the
   Goldstones and ghosts itself in unitary gauge. *)
FeynmanGauge = True;

M$ModelName = "SM_CKM_MSbar";

M$Information = {
  Authors -> {"K. Yasuda"},
  Date    -> "2026-10-17",
  Version -> "1.0",
  Comment -> "Standard Model with the CKM matrix, MS-bar parameters, general R_xi gauge (cross-check model for the loop stack)"
};

M$InteractionOrderHierarchy = {
  {QCD, 1},
  {QED, 2}
};

(* ************************** *)
(* *****      vevs      ***** *)
(* ************************** *)

M$vevs = { {Phi[2], vev} };

(* ************************** *)
(* *****  Gauge groups  ***** *)
(* ************************** *)

M$GaugeGroups = {
  U1Y == {
    Abelian          -> True,
    CouplingConstant -> g1,
    GaugeBoson       -> B,
    Charge           -> Y
  },
  SU2L == {
    Abelian           -> False,
    CouplingConstant  -> gw,
    GaugeBoson        -> Wi,
    StructureConstant -> Eps,
    Representations   -> {Ta, SU2D},
    Definitions       -> {Ta[a_, b_, c_] -> PauliSigma[a, b, c]/2, FSU2L[i_, j_, k_] :> I Eps[i, j, k]}
  },
  SU3C == {
    Abelian           -> False,
    CouplingConstant  -> gs,
    GaugeBoson        -> G,
    StructureConstant -> f,
    Representations   -> {T, Colour},
    SymmetricTensor   -> dSUN
  }
};

(* ************************** *)
(* *****    Indices     ***** *)
(* ************************** *)

IndexRange[Index[SU2W      ]] = Unfold[Range[3]];
IndexRange[Index[SU2D      ]] = Unfold[Range[2]];
IndexRange[Index[Gluon     ]] = NoUnfold[Range[8]];
IndexRange[Index[Colour    ]] = NoUnfold[Range[3]];
IndexRange[Index[Generation]] = Range[3];

IndexStyle[SU2W,       j];
IndexStyle[SU2D,       k];
IndexStyle[Gluon,      a];
IndexStyle[Colour,     m];
IndexStyle[Generation, f];

(* ************************** *)
(* *****   Parameters   ***** *)
(* ************************** *)

M$Parameters = {
  (* external: MS-bar values at the benchmark scale *)
  aEWM1 == {
    ParameterType    -> External,
    BlockName        -> SMINPUTS,
    OrderBlock       -> 1,
    Value            -> 128.,
    InteractionOrder -> {QED, -2},
    Description      -> "Inverse of the MS-bar electromagnetic coupling 4 pi/ee^2"
  },
  aS == {
    ParameterType    -> External,
    BlockName        -> SMINPUTS,
    OrderBlock       -> 3,
    Value            -> 0.118,
    InteractionOrder -> {QCD, 2},
    TeX              -> Subscript[\[Alpha], s],
    Description      -> "MS-bar strong coupling gs^2/(4 pi)"
  },
  xiA == {
    ParameterType -> External,
    BlockName     -> GAUGE,
    OrderBlock    -> 1,
    Value         -> 1.,
    TeX           -> Subscript[\[Xi], A],
    Description   -> "Gauge parameter of the photon"
  },
  xiZ == {
    ParameterType -> External,
    BlockName     -> GAUGE,
    OrderBlock    -> 2,
    Value         -> 1.,
    TeX           -> Subscript[\[Xi], Z],
    Description   -> "Gauge parameter of the Z"
  },
  xiW == {
    ParameterType -> External,
    BlockName     -> GAUGE,
    OrderBlock    -> 3,
    Value         -> 1.,
    TeX           -> Subscript[\[Xi], W],
    Description   -> "Gauge parameter of the W"
  },
  xiG == {
    ParameterType -> External,
    BlockName     -> GAUGE,
    OrderBlock    -> 4,
    Value         -> 1.,
    TeX           -> Subscript[\[Xi], G],
    Description   -> "Gauge parameter of the gluon"
  },
  (* CKM: PDG standard parametrization, PDG 2024 global fit as the benchmark *)
  s12 == {
    ParameterType -> External,
    BlockName     -> CKMBLOCK,
    OrderBlock    -> 1,
    Value         -> 0.22501,
    TeX           -> Subscript[s, 12],
    Description   -> "Sine of the CKM angle theta_12"
  },
  s23 == {
    ParameterType -> External,
    BlockName     -> CKMBLOCK,
    OrderBlock    -> 2,
    Value         -> 0.04183,
    TeX           -> Subscript[s, 23],
    Description   -> "Sine of the CKM angle theta_23"
  },
  s13 == {
    ParameterType -> External,
    BlockName     -> CKMBLOCK,
    OrderBlock    -> 3,
    Value         -> 0.003732,
    TeX           -> Subscript[s, 13],
    Description   -> "Sine of the CKM angle theta_13"
  },
  dCKM == {
    ParameterType -> External,
    BlockName     -> CKMBLOCK,
    OrderBlock    -> 4,
    Value         -> 1.147,
    TeX           -> \[Delta],
    Description   -> "CKM phase delta"
  },
  (* internal *)
  aEW == {
    ParameterType    -> Internal,
    Value            -> 1/aEWM1,
    InteractionOrder -> {QED, 2},
    TeX              -> Subscript[\[Alpha], EW],
    Description      -> "MS-bar electromagnetic coupling"
  },
  ee == {
    ParameterType    -> Internal,
    Value            -> Sqrt[4 Pi aEW],
    InteractionOrder -> {QED, 1},
    TeX              -> e,
    Description      -> "MS-bar electric charge gw g1/sqrt(gw^2 + g1^2)"
  },
  cw == {
    ParameterType -> Internal,
    Value         -> MW/MZ,
    TeX           -> Subscript[c, w],
    Description   -> "Cosine of the MS-bar weak mixing angle gw/sqrt(gw^2 + g1^2)"
  },
  sw == {
    ParameterType -> Internal,
    Value         -> Sqrt[1 - cw^2],
    TeX           -> Subscript[s, w],
    Description   -> "Sine of the MS-bar weak mixing angle g1/sqrt(gw^2 + g1^2)"
  },
  gw == {
    ParameterType    -> Internal,
    Definitions      -> {gw -> ee/sw},
    InteractionOrder -> {QED, 1},
    TeX              -> Subscript[g, w],
    Description      -> "SU(2)L coupling"
  },
  g1 == {
    ParameterType    -> Internal,
    Definitions      -> {g1 -> ee/cw},
    InteractionOrder -> {QED, 1},
    TeX              -> Subscript[g, 1],
    Description      -> "U(1)Y coupling"
  },
  gs == {
    ParameterType    -> Internal,
    Value            -> Sqrt[4 Pi aS],
    InteractionOrder -> {QCD, 1},
    TeX              -> Subscript[g, s],
    ParameterName    -> G,
    Description      -> "SU(3)C coupling"
  },
  vev == {
    ParameterType    -> Internal,
    Value            -> 2 MW sw/ee,
    InteractionOrder -> {QED, -1},
    Description      -> "Minimum of the tree potential sqrt(muH2/lam)"
  },
  lam == {
    ParameterType    -> Internal,
    Value            -> MH^2/(2 vev^2),
    InteractionOrder -> {QED, 2},
    Description      -> "Higgs quartic coupling"
  },
  muH2 == {
    ParameterType -> Internal,
    Value         -> lam vev^2,
    TeX           -> Subscript[\[Mu], H]^2,
    Description   -> "Mass parameter of the Higgs potential"
  },
  yl == {
    ParameterType    -> Internal,
    Indices          -> {Index[Generation], Index[Generation]},
    Definitions      -> {yl[i_?NumericQ, j_?NumericQ] :> 0 /; (i =!= j)},
    Value            -> {yl[1, 1] -> Sqrt[2] Me/vev, yl[2, 2] -> Sqrt[2] MMU/vev, yl[3, 3] -> Sqrt[2] MTA/vev},
    ComplexParameter -> False,
    InteractionOrder -> {QED, 1},
    ParameterName    -> {yl[1, 1] -> ye, yl[2, 2] -> ym, yl[3, 3] -> ytau},
    TeX              -> Superscript[y, l],
    Description      -> "Lepton Yukawa couplings (diagonal)"
  },
  yu == {
    ParameterType    -> Internal,
    Indices          -> {Index[Generation], Index[Generation]},
    Definitions      -> {yu[i_?NumericQ, j_?NumericQ] :> 0 /; (i =!= j)},
    Value            -> {yu[1, 1] -> Sqrt[2] MU/vev, yu[2, 2] -> Sqrt[2] MC/vev, yu[3, 3] -> Sqrt[2] MT/vev},
    ComplexParameter -> False,
    InteractionOrder -> {QED, 1},
    ParameterName    -> {yu[1, 1] -> yup, yu[2, 2] -> yc, yu[3, 3] -> yt},
    TeX              -> Superscript[y, u],
    Description      -> "Up-type Yukawa couplings (diagonal)"
  },
  yd == {
    ParameterType    -> Internal,
    Indices          -> {Index[Generation], Index[Generation]},
    Definitions      -> {yd[i_?NumericQ, j_?NumericQ] :> 0 /; (i =!= j)},
    Value            -> {yd[1, 1] -> Sqrt[2] MD/vev, yd[2, 2] -> Sqrt[2] MS/vev, yd[3, 3] -> Sqrt[2] MB/vev},
    ComplexParameter -> False,
    InteractionOrder -> {QED, 1},
    ParameterName    -> {yd[1, 1] -> ydo, yd[2, 2] -> ys, yd[3, 3] -> yb},
    TeX              -> Superscript[y, d],
    Description      -> "Down-type Yukawa couplings (diagonal)"
  },
  (* CKM: cosines and the matrix V = R23 U13(delta) R12 *)
  c12 == {
    ParameterType -> Internal,
    Value         -> Sqrt[1 - s12^2],
    TeX           -> Subscript[c, 12],
    Description   -> "Cosine of the CKM angle theta_12"
  },
  c23 == {
    ParameterType -> Internal,
    Value         -> Sqrt[1 - s23^2],
    TeX           -> Subscript[c, 23],
    Description   -> "Cosine of the CKM angle theta_23"
  },
  c13 == {
    ParameterType -> Internal,
    Value         -> Sqrt[1 - s13^2],
    TeX           -> Subscript[c, 13],
    Description   -> "Cosine of the CKM angle theta_13"
  },
  CKM == {
    ParameterType    -> Internal,
    Indices          -> {Index[Generation], Index[Generation]},
    Unitary          -> True,
    ComplexParameter -> True,
    Value            -> {
      CKM[1, 1] -> c12 c13,
      CKM[1, 2] -> s12 c13,
      CKM[1, 3] -> s13 Exp[-I dCKM],
      CKM[2, 1] -> -s12 c23 - c12 s23 s13 Exp[I dCKM],
      CKM[2, 2] -> c12 c23 - s12 s23 s13 Exp[I dCKM],
      CKM[2, 3] -> s23 c13,
      CKM[3, 1] -> s12 s23 - c12 c23 s13 Exp[I dCKM],
      CKM[3, 2] -> -c12 s23 - s12 c23 s13 Exp[I dCKM],
      CKM[3, 3] -> c23 c13},
    InteractionOrder -> {QED, 0},
    TeX              -> V,
    Description      -> "CKM matrix (row: up-type, column: down-type generation)"
  }
};

