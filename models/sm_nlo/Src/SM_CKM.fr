    ClassName      -> uR,
    Unphysical     -> True,
    Indices        -> {Index[Generation], Index[Colour]},
    FlavorIndex    -> Generation,
    SelfConjugate  -> False,
    QuantumNumbers -> {Y -> 2/3},
    Definitions    -> {uR[sp1_, ff_, cc_] :> Module[{sp2}, ProjP[sp1, sp2] uq[sp2, ff, cc]]}
  },
  F[15] == {
    ClassName      -> dR,
    Unphysical     -> True,
    Indices        -> {Index[Generation], Index[Colour]},
    FlavorIndex    -> Generation,
    SelfConjugate  -> False,
    QuantumNumbers -> {Y -> -1/3},
    Definitions    -> {dR[sp1_, ff_, cc_] :> Module[{sp2}, ProjP[sp1, sp2] dq[sp2, ff, cc]]}
  },

  (* scalars *)
  S[1] == {
    ClassName       -> H,
    SelfConjugate   -> True,
    Mass            -> {MH, 125.},
    Width           -> {WH, 0.0041},
    PropagatorLabel -> "H",
    PropagatorType  -> D,
    PropagatorArrow -> None,
    PDG             -> 25,
    ParticleName    -> "H",
    FullName        -> "H"
  },
  S[2] == {
    ClassName       -> G0,
    SelfConjugate   -> True,
    Goldstone       -> Z,
    Mass            -> {MZ, 91.},
    Width           -> {WZ, 2.4955},
    PropagatorLabel -> "Go",
    PropagatorType  -> D,
    PropagatorArrow -> None,
    PDG             -> 250,
    ParticleName    -> "G0",
    FullName        -> "G0"
  },
  S[3] == {
    ClassName        -> GP,
    SelfConjugate    -> False,
    Goldstone        -> W,
    Mass             -> {MW, 80.},
    QuantumNumbers   -> {Q -> 1},
    Width            -> {WW, 2.085},
    PropagatorLabel  -> "GP",
    PropagatorType   -> D,
    PropagatorArrow  -> None,
    PDG              -> 251,
    ParticleName     -> "G+",
    AntiParticleName -> "G-",
    FullName         -> "GP"
  },
  S[11] == {
    ClassName      -> Phi,
    Unphysical     -> True,
    Indices        -> {Index[SU2D]},
    FlavorIndex    -> SU2D,
    SelfConjugate  -> False,
    QuantumNumbers -> {Y -> 1/2},
    Definitions    -> {Phi[1] -> -I GP, Phi[2] -> (vev + H + I G0)/Sqrt[2]}
  }
};

(* FeynArts propagators: R_xi gauge (Goldstones and ghosts of Z and W have mass^2 xi M^2) *)
GaugeXi[V[1]]  = GaugeXi[A];
GaugeXi[V[2]]  = GaugeXi[Z];
GaugeXi[V[3]]  = GaugeXi[W];
GaugeXi[V[4]]  = GaugeXi[G];
GaugeXi[S[1]]  = 1;
GaugeXi[S[2]]  = GaugeXi[Z];
GaugeXi[S[3]]  = GaugeXi[W];
GaugeXi[U[1]]  = GaugeXi[A];
GaugeXi[U[2]]  = GaugeXi[Z];
GaugeXi[U[3]]  = GaugeXi[W];
GaugeXi[U[4]]  = GaugeXi[W];
GaugeXi[U[5]]  = GaugeXi[G];

(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

LGaugeSM := Block[{mu, nu, ii, aa},
  ExpandIndices[(-1/4 FS[B, mu, nu] FS[B, mu, nu] - 1/4 FS[Wi, mu, nu, ii] FS[Wi, mu, nu, ii]
    - 1/4 FS[G, mu, nu, aa] FS[G, mu, nu, aa]), FlavorExpand -> SU2W]];

(* CKM: unitarity of V for a summed dummy index a: sum_a V_ab conj(V_ac) = (V^dagger V)_cb = delta_bc and
   sum_a V_ba conj(V_ca) = (V V^dagger)_bc = delta_bc.  Applied to the expanded terms, where every generation index
   of a product is either summed (dummy) or absent, so a repeated first (or second) index is always a dummy. *)
(* pattern names with $ so that they cannot be model symbols (b, c are quarks) *)
ckmUnitarity = {CKM[i1$_, i2$_] Conjugate[CKM[i1$_, i3$_]] :> IndexDelta[i2$, i3$],
   CKM[i2$_, i1$_] Conjugate[CKM[i3$_, i1$_]] :> IndexDelta[i2$, i3$]};

(* ...RawSM: before the unitarity rules (generate_SM_CKM.wl checks the rules against the explicit parametrization) *)
LFermionRawSM := Block[{mu},
  ExpandIndices[I (QLbar.Ga[mu].DC[QL, mu] + LLbar.Ga[mu].DC[LL, mu]
    + uRbar.Ga[mu].DC[uR, mu] + dRbar.Ga[mu].DC[dR, mu] + lRbar.Ga[mu].DC[lR, mu]),
    FlavorExpand -> {SU2W, SU2D}]];
LFermionSM := LFermionRawSM /. ckmUnitarity;

(* V = -muH2 |Phi|^2 + lam |Phi|^4 has its minimum at |Phi|^2 = vev^2/2 because muH2 = lam vev^2 *)
LHiggsSM := Block[{ii, jj, mu},
  ExpandIndices[(DC[Phibar[ii], mu] DC[Phi[ii], mu] + muH2 Phibar[ii] Phi[ii]
    - lam Phibar[ii] Phi[ii] Phibar[jj] Phi[jj]), FlavorExpand -> {SU2D, SU2W}]];

(* Yukawa couplings: Yu = yu, Yd = CKM.yd, Yl = yl with diagonal yu, yd, yl; every index appears exactly twice;
   Phitilde_i = Eps[i, j] Phibar[j] = (conj(Phi_2), -conj(Phi_1)).
   CKM: (Yd)_{ff1 ff3} = CKM[ff1, ff2] yd[ff2, ff3].  The neutral part QLbar_2 Yd Phi_2 dR contains V^dagger V and is
   diagonal after ckmUnitarity; the charged parts keep V (G+ ubar V yd dR) and V^dagger (G- dbar V^dagger yu uR). *)
LYukawaRawSM := Block[{sp, ii, jj, cc, ff1, ff2, ff3, yuk},
  yuk = ExpandIndices[(-CKM[ff1, ff2] yd[ff2, ff3] QLbar[sp, ii, ff1, cc].dR[sp, ff3, cc] Phi[ii]
    - yl[ff1, ff2] LLbar[sp, ii, ff1].lR[sp, ff2] Phi[ii]
    - yu[ff1, ff2] QLbar[sp, ii, ff1, cc].uR[sp, ff2, cc] Eps[ii, jj] Phibar[jj]), FlavorExpand -> SU2D];
  yuk + HC[yuk]];
LYukawaSM := LYukawaRawSM /. ckmUnitarity;

(* Faddeev-Popov term, gauge part: - sum_a ubar^a d^mu (D_mu u)^a for B, W^a and the gluon.  The antighosts rotate
   with the same real matrices as the ghosts, so this equals - sum_k ubar^k d.(s V^k) in the mass basis. *)
LGhostGaugeSM := Block[{mu, ii, aa},
  ExpandIndices[(-ghBbar.del[del[ghB, mu], mu] - ghWibar[ii].del[DC[ghWi[ii], mu], mu]
    - ghGbar[aa].del[DC[ghG[aa], mu], mu]), FlavorExpand -> SU2W]];

(* Faddeev-Popov term, scalar part: - ubar^k s F^k with F^Z = d.Z - xiZ MZ G0, F^+- = d.W^+- - xiW MW G^+-
   contributes  xiZ MZ ubarZ s G0 + xiW MW (ubar+ s G+ + ubar- s G-).
   s Phi = i (gw/2 sigma^a u^a + g1/2 u^B) Phi with commuting placeholders ghPH$[k] for the ghosts
   {u^B, u^1, u^2, u^3} (real: conj(ghPH$[k]) = ghPH$[k]); s Phi^dagger = -i Phi^dagger (...).
   Then G+ = i Phi_1, G- = -i conj(Phi_1), G0 = (Phi_2 - conj(Phi_2))/(i sqrt 2).  Each coefficient of ghPH$[k] multiplies
   the antighost-ghost product ubar.u_k, u_k = {ghB, ghWi[1], ghWi[2], ghWi[3]} (expanded by FeynRules). *)
LGhostScalarSM := Block[{ugen, phiv, phibarv, sPhi, sPhibar, sGP, sGPbar, sG0, ghs, term},
  ugen = gw/2 Sum[ghPH$[k + 1] {{{0, 1}, {1, 0}}, {{0, -I}, {I, 0}}, {{1, 0}, {0, -1}}}[[k]], {k, 3}]
         + g1/2 ghPH$[1] IdentityMatrix[2];
  phiv    = {-I GP, (vev + H + I G0)/Sqrt[2]};
  phibarv = {I GPbar, (vev + H - I G0)/Sqrt[2]};
  sPhi    = I ugen.phiv;
  sPhibar = -I phibarv.ugen;
  sGP     = Expand[I sPhi[[1]]];
  sGPbar  = Expand[-I sPhibar[[1]]];
  sG0     = Expand[(sPhi[[2]] - sPhibar[[2]])/(I Sqrt[2])];
  ghs = {ghB, ghWi[1], ghWi[2], ghWi[3]};
  term[bar_, sX_] := Sum[bar.ghs[[k]] Coefficient[sX, ghPH$[k]], {k, 4}];
  ExpandIndices[(xiZ MZ term[ghZbar, sG0] + xiW MW (term[ghWpbar, sGP] + term[ghWmbar, sGPbar])),
    FlavorExpand -> SU2W]];

LGhostSM := LGhostGaugeSM + LGhostScalarSM;

LSM := LGaugeSM + LFermionSM + LHiggsSM + LYukawaSM + LGhostSM;
